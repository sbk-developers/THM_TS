class Animal {
    kind = "animal"

    def __init__(self, name: str) {
        self.name = name
    }

    def speak(self) {
        return self.name + " makes a sound"
    }
}

class Dog(Animal) {
    kind = "dog"

    def __init__(self, name: str) {
        super().__init__(name)
    }

    def speak(self) {
        return super().speak() + " and barks"
    }
}

dog = Dog("Rex")
dog.age = 3
write(dog.name, dog.age, dog.kind, dog.speak())
write(isinstance(dog, Dog), isinstance(dog, Animal), issubclass(Dog, Animal))
